GITHUB_TOKEN=your_github_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HF_TOKEN=your_huggingface_token_here

# Optional
OPENAI_API_KEY=

# Optional — prefix for pre-built Docker images (one per Python version).
# Images expected at <prefix>:3.9, <prefix>:3.10, <prefix>:3.11, <prefix>:3.12, <prefix>:3.13
# Skips ~13s of apt-get + pip install uv per container. See docker/base/Dockerfile.
# Build: for v in 3.9 3.10 3.11 3.12 3.13; do
#   docker buildx build docker/base/ --build-arg PYTHON_VERSION=$v -t <prefix>:$v --push; done
DECEPTRON_BASE_IMAGE_PREFIX=

# Optional — local Dagster home (UI/daemon run history, sqlite db, logs).
# If unset, `dagster dev` uses a throwaway temp dir each run; set this to
# persist state across restarts. docker-compose sets DAGSTER_HOME itself.
DAGSTER_HOME=
