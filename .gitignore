# Environment
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# LLM analysis cache (regeneratable from SHA)
data/deceptron/tasks/cache/

# Data (large files — full versions with logs / generated artifacts)
data/deceptron/mining/repos_verified.jsonl
data/deceptron/tasks/tasks.jsonl
data/deceptron/trajectories/*.jsonl
data/deceptron/scores/prompted.jsonl
data/deceptron/results/

# repro / compare — fully regeneratable from deceptron's trajectories
data/repro/
data/compare/

# Keep directory structure
!data/deceptron/results/.gitkeep

# Committed snapshots (small, no logs)
!data/deceptron/mining/repos.jsonl
!data/deceptron/mining/repos_verified_clean.jsonl

# ML artifacts
runs/
*.safetensors
*.bin
wandb/

# OS
.DS_Store

# Dagster local-dev run history / sqlite db / compute logs (gitignored —
# regenerated; docker-compose uses a named volume instead). `dagster dev`
# creates .tmp_dagster_home_*/ in cwd whenever $DAGSTER_HOME is unset.
dagster_home/
.tmp_dagster_home_*/
