# Environment
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# LLM analysis cache (regeneratable from SHA)
data/agents/deceptron/tasks/cache/

# Data (large files — full versions with logs / generated artifacts)

## Deceptron — full versions with logs / generated artifacts
data/agents/deceptron/mining/repos_verified.jsonl
# data/agents/deceptron/tasks/tasks.jsonl  # tracked — LLM-generated, expensive to regenerate
data/agents/deceptron/trajectories/*.jsonl
data/agents/deceptron/scores/prompted.jsonl
data/agents/deceptron/results/

## apollo / benchmark — fully regeneratable from deceptron's trajectories
data/agents/apollo/
data/benchmark/

# Keep directory structure
!data/agents/deceptron/results/.gitkeep

# Committed snapshots (small, no logs)
!data/agents/deceptron/mining/repos.jsonl
!data/agents/deceptron/mining/repos_verified_clean.jsonl

# ML artifacts
runs/
*.safetensors
*.bin
wandb/

# OS
.DS_Store

# Dagster local-dev run history / sqlite db / compute logs (gitignored —
# regenerated; docker-compose uses a named volume instead). `dagster dev`
# creates .tmp_dagster_home_*/ in cwd whenever $DAGSTER_HOME is unset.
dagster_home/
.tmp_dagster_home_*/

# Claude Code personal/machine-local settings
.claude/settings.local.json
